# Copy to .env (optional). Defaults shown.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Voice is left out of the combined score by default (its model is unreliable). Set true to include it.
# Read from the environment (not auto-loaded from this file).
INCLUDE_VOICE_IN_SCORE=false
